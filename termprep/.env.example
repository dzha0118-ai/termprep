# TermPrep Configuration Template
# Copy this file to .env and fill in your API keys.
# Without AI keys, TermPrep automatically uses free engines (Google Translate + Youdao).

# ═══════════════════════════════════════════════════════════════
#  AI Translation (Optional — enhances quality significantly)
# ═══════════════════════════════════════════════════════════════

# Option A: DeepSeek — 推荐，性价比高，国内可访问
# TERMPREP_AI_PROVIDER=deepseek
# TERMPREP_AI_API_KEY=sk-your-deepseek-key
# TERMPREP_AI_MODEL=deepseek-chat
# TERMPREP_AI_BASE_URL=https://api.deepseek.com/v1

# Option B: Kimi (Moonshot) — 国内稳定，长文本支持
# TERMPREP_AI_PROVIDER=kimi
# TERMPREP_AI_API_KEY=sk-your-kimi-key
# TERMPREP_AI_MODEL=moonshot-v1-128k

# Option C: OpenAI
# TERMPREP_AI_PROVIDER=openai
# TERMPREP_AI_API_KEY=sk-your-openai-key
# TERMPREP_AI_MODEL=gpt-4o-mini

# Option D: Ollama (本地运行，零成本，隐私优先)
# TERMPREP_AI_PROVIDER=ollama
# TERMPREP_AI_API_KEY=ollama
# TERMPREP_AI_BASE_URL=http://localhost:11434/v1
# TERMPREP_AI_MODEL=llama3.1

# Option E: 自定义 OpenAI-compatible API
# TERMPREP_AI_PROVIDER=custom
# TERMPREP_AI_API_KEY=your-key
# TERMPREP_AI_BASE_URL=https://your-api.com/v1
# TERMPREP_AI_MODEL=your-model

# AI 温度 (0.0-1.0, 越低越确定，推荐翻译用 0.3)
# TERMPREP_AI_TEMPERATURE=0.3

# AI 最大 token (默认 4096)
# TERMPREP_AI_MAX_TOKENS=4096

# AI 请求超时 (秒)
# TERMPREP_AI_TIMEOUT=60

# AI 引擎优先级 (数值越小优先级越高)
# TERMPREP_AI_PRIORITY=5

# ═══════════════════════════════════════════════════════════════
#  Youdao Dictionary (Optional — 术语查询)
# ═══════════════════════════════════════════════════════════════

# TERMPREP_YOUDAO_KEY=your-youdao-app-key
# TERMPREP_YOUDAO_SECRET=your-youdao-secret

# ═══════════════════════════════════════════════════════════════
#  Advanced
# ═══════════════════════════════════════════════════════════════

# 数据库目录 (默认: ./data)
# TERMPREP_DB_DIR=./data

# 翻译缓存 (true/false)
# TERMPREP_TRANSLATION_CACHE=false

# 最大降级次数 (引擎失败时的 fallback 次数)
# TERMPREP_MAX_FALLBACKS=3
